# ─────────────────────────────────────────────────────────────────────────────
#  EventDesk environment template.
#  Copy to .env.local (local dev) and add the same keys in Vercel → Settings →
#  Environment Variables (production). NEVER commit a file with real values.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL of the app. Used for auth email redirects.
# Local: http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API (Data API URL).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase → Project Settings → API Keys → "Publishable key" (sb_publishable_...)
# or the legacy "anon public" key. Safe for the browser: Row Level Security protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# External APIs: Open-Meteo (weather + geocoding) and OpenStreetMap (map embed)
# are free production APIs that need NO key. Nothing to set here.
