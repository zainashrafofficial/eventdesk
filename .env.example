# ─────────────────────────────────────────────────────────────────────────────
#  Cadence environment template.
#  Copy to .env.local (local dev) and add the same keys in Vercel → Settings →
#  Environment Variables (production). NEVER commit a file with real values.
#  Every integration degrades gracefully: if its keys are missing, the UI shows
#  "… isn't configured" instead of crashing.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL of the app (no trailing slash). Used for auth email redirects
# and to build the Google OAuth redirect URI ({SITE}/api/drive/callback).
# Local: http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Auth + Postgres) ───────────────────────────────────────────────
# Supabase → Project Settings → API (Data API URL).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase → Project Settings → API Keys → "Publishable key" (sb_publishable_...)
# or the legacy "anon public" key. Safe for the browser: Row Level Security protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase → Project Settings → API Keys → "Secret key" (sb_secret_...) or legacy service_role.
# SERVER ONLY (never prefix with NEXT_PUBLIC_). Bypasses RLS, so it is used in exactly three
# places: storing/reading Google Drive refresh tokens, the reminder cron job, and the email log.
SUPABASE_SECRET_KEY=

# ── Google Gemini (caption generation) ───────────────────────────────────────
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# ── Google Drive (draft sync, OAuth 2.0) ─────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (type: Web application).
# Enable the "Google Drive API" for the project first.
# Authorised redirect URIs:  http://localhost:3000/api/drive/callback
#                            https://your-app.vercel.app/api/drive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Resend (transactional email) ─────────────────────────────────────────────
# https://resend.com → API Keys. In test mode (no verified domain) Resend only delivers
# to the email address of the Resend account itself.
RESEND_API_KEY=
# Optional. Defaults to "Cadence <onboarding@resend.dev>". Use your verified domain in production.
EMAIL_FROM="Cadence <onboarding@resend.dev>"

# ── Scheduled reminders ──────────────────────────────────────────────────────
# Any long random string (e.g. `openssl rand -hex 32`). Supabase pg_cron calls
# GET /api/cron/notify every minute with "Authorization: Bearer <CRON_SECRET>"
# (see supabase/cron.sql). Requests without the exact secret get 401.
CRON_SECRET=
