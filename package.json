{
  "name": "eventdesk",
  "version": "1.0.0",
  "private": true,
  "description": "EventDesk: plan events with secure auth, Supabase CRUD, file storage and live weather/maps.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "screenshots": "node scripts/screenshots.mjs",
    "test:security": "node --env-file=.env.local scripts/security-check.mjs",
    "test:e2e": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.74.0",
    "motion": "^12.43.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright-core": "^1.49.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
